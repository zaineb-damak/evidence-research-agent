# ---- Core services (docker-compose defaults) ----
POSTGRES_DSN=postgresql+psycopg://research:research@localhost:5432/research
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=researchpass
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# ---- LLM provider selection ----
# One of: openai | anthropic | vertex | oai_compat
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# Keys (only the one for the selected provider is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For oai_compat (Ollama / vLLM / etc.)
OAI_COMPAT_BASE_URL=http://localhost:11434/v1
OAI_COMPAT_API_KEY=not-needed
# For vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ---- Embeddings ----
# One of: openai | voyage
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
VOYAGE_API_KEY=

# ---- Search / connectors ----
TAVILY_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=evidence-research-agent/0.1

# ---- Observability ----
# Langfuse is a managed cloud service (cloud.langfuse.com, or the EU/US region
# URL from your project settings). Leave the keys blank to disable tracing.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Deployment identity — stamped onto every log line and metric.
# ENVIRONMENT is one of: development | staging | production.
ENVIRONMENT=development
SERVICE_NAME=evidence-research-agent
RELEASE_VERSION=dev

# LOG_FORMAT: console (readable locally) | json (what a cluster collector parses).
LOG_LEVEL=info
LOG_FORMAT=console

# Prometheus. The API serves /metrics; the worker opens its own port for it.
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100

# How long a dependency probe behind GET /health/ready may block.
READINESS_TIMEOUT_SECONDS=2

# ---- App ----
CRAWLER_USER_AGENT=evidence-research-agent/0.1 (+https://github.com/you/evidence-research-agent)
# Comma-separated API keys the HTTP API accepts as Bearer tokens (required — the
# API fails closed with none configured).
API_KEYS=change-me-local-key

# ---- CORS ----
# Comma-separated list of allowed browser origins (e.g. the frontend dev
# server, http://localhost:5173). Empty disables CORS middleware entirely.
CORS_ALLOWED_ORIGINS=
