# Keep the build context small and, more importantly, keep secrets and local
# state out of the image. Anything not listed in a COPY still costs transfer
# time and can leak through a stray `COPY . .`.

.git
.github
.gitignore

# Secrets and local environment
.env
.env.*
!.env.example

# Python build/test artifacts
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node — the web image installs from the lockfile in its own builder stage
apps/web/node_modules/
apps/web/dist/
apps/web/tsconfig.tsbuildinfo

# Nothing the runtime needs
docs/
evals/reports/
infra/k8s/
tests/
*.md
!README.md
.DS_Store
.idea/
.vscode/
